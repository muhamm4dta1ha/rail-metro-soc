# Copy to src/simulation/.env (git-ignored). Lab-only, synthetic credentials - never reuse real passwords.
PIS_USERS=ops_admin:change-me-lab-only,ops_lead:change-me-too-lab-only
JUMPHOST_PASSWORD=change-me-lab-only-too
# How long the occ driver container runs the real HTTP/Modbus/SSH drivers for, in seconds.
NORMAL_DAY_DURATION=1800
